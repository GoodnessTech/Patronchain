# ==============================================================================
# PatronChain Environment Configuration
# ==============================================================================
# For Vercel deployment:
# Configure these variables in Project Settings -> Environment Variables.
# All VITE_* variables are embedded at build time into the client bundle.
# ==============================================================================

# Active network mode: 'testnet' or 'mainnet'
VITE_ACTIVE_NETWORK=testnet

# Smart Contract Addresses
# Live BOT Chain Testnet (Bohr - Chain ID 968)
VITE_PATRONCHAIN_TESTNET_ADDRESS=0xb1ceb34818617a5b59c0d6ca98e2c4481b8a845f

# BOT Chain Mainnet (Chain ID 677) - Set when deployed
VITE_PATRONCHAIN_MAINNET_ADDRESS=0x0000000000000000000000000000000000000000

# Optional custom RPC endpoints (defaults are used if omitted)
VITE_TESTNET_RPC_URL=https://rpc.bohr.life
VITE_MAINNET_RPC_URL=https://rpc.botchain.ai

# Optional custom Block Explorer URLs
VITE_TESTNET_EXPLORER_URL=https://scan.bohr.life
VITE_MAINNET_EXPLORER_URL=https://scan.botchain.ai

# ==============================================================================
# SCRIPT / BACKEND ONLY (DO NOT SET ON VERCEL OR EXPOSE PUBLICLY)
# ==============================================================================
# PRIVATE_KEY=0x... (Only for deployment scripts scripts/deploy_testnet.mjs)
# MAINNET_DEPLOYER_PRIVATE_KEY=0x... (Only for scripts/deploy_mainnet.mjs)
# CONFIRM_MAINNET_DEPLOYMENT=false
