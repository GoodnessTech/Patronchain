# ==============================================================================
# PatronChain Environment Configuration — BOT Chain Mainnet
# ==============================================================================
# For Vercel / Cloud deployment:
# Configure these variables in Project Settings -> Environment Variables.
# All VITE_* variables are embedded at build time into the client bundle.
# ==============================================================================

VITE_ACTIVE_NETWORK=mainnet
VITE_CHAIN_ID=677
VITE_NETWORK_NAME=BOT Chain Mainnet
VITE_NATIVE_CURRENCY=BOT

# Deployed PatronChain Mainnet Contract Address
VITE_PATRONCHAIN_CONTRACT_ADDRESS=0xa5590be3e48dd445fa871fd813bce8f253a85439

# Official BOT Chain Mainnet RPC Endpoint
VITE_RPC_URL=https://rpc.botchain.ai

# Official BOT Chain Mainnet Explorer
VITE_EXPLORER_URL=https://scan.botchain.ai

# ==============================================================================
# SCRIPT / BACKEND ONLY (DO NOT EXPOSE PUBLICLY OR SET IN CLIENT BUNDLE)
# ==============================================================================
# PRIVATE_KEY=0x... (Only for local administrative or deployment scripts)
# CONFIRM_MAINNET_DEPLOYMENT=false
